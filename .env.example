# CommandGrid local environment example. Never commit real secrets.
DATABASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
COMMANDGRID_AI_GATEWAY_ID=commandgrid
COMMANDGRID_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account-id>/commandgrid
COMMANDGRID_AI_DISABLED=false
COMMANDGRID_NEON_REST_URL=
HYPERDRIVE_BINDING=COMMANDGRID_DB
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_COMMANDGRID_DB=
NODE_ENV=development
DEMO_MODE=true
